{
  "name": "iqra-island",
  "version": "1.0.0",
  "private": true,
  "description": "Iqra Island – Arabic & Islamic learning for kids (Capacitor Android wrapper)",
  "scripts": {
    "fonts": "node scripts/vendor-fonts.mjs",
    "android:add": "cap add android",
    "android:assets": "capacitor-assets generate --android --assetPath assets --iconBackgroundColor \"#bdeefa\" --splashBackgroundColor \"#bdeefa\" --splashBackgroundColorDark \"#16324a\"",
    "android:sync": "cap sync android",
    "android:prepare": "node scripts/prepare-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor-community/text-to-speech": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  }
}
